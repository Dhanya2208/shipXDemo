{
  "name": "shopify-app-node",
  "version": "3.0.0",
  "private": true,
  "description": "Shopify's node app for CLI tool",
  "scripts": {
    "dev": "nodemon --watch server.js --watch server --watch config.js server.js",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NODE_ENV=production node server.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1164.0",
    "@aws-sdk/client-dynamodb": "^3.1166.0",
    "@aws-sdk/lib-dynamodb": "^3.1165.0",
    "@koa/router": "^15.7.1",
    "@shopify/shopify-api": "^15.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "ecad": "^0.2.0",
    "jsonwebtoken": "^9.0.2",
    "koa": "^3.3.0",
    "koa-body": "^8.0.1",
    "memcached": "^2.2.2",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
